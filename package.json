{
  "name": "polyfill-analyzer",
  "version": "1.0.0",
  "description": "AST-driven JavaScript polyfill and syntax transform analyzer across bundlers and Web Platform Baseline rules",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "polyfill-analyzer": "./dist/cli/index.js",
    "polyfill-detector": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "web": "node dist/cli/index.js serve",
    "serve": "node dist/cli/index.js serve",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "test:samples": "npm test --prefix ../es-samples",
    "test:e2e": "node tests/e2e_requirements/runner.js --tolerant",
    "lint": "eslint src/ tests/"
  },
  "keywords": [
    "polyfill",
    "analyzer",
    "baseline",
    "ast-grep",
    "bundlers",
    "webpack",
    "rollup",
    "esbuild",
    "swc"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ast-grep/napi": "^0.40.5",
    "@mdn/browser-compat-data": "^5.5.0",
    "baseline-browser-mapping": "^2.11.24",
    "browserslist": "^4.23.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "es-samples": "file:../es-samples",
    "semver": "^7.6.0",
    "web-features": "^3.32.0",
    "yaml": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@swc/core": "^1.4.11",
    "@types/node": "^20.12.0",
    "@types/semver": "^7.5.8",
    "core-js": "^3.37.0",
    "esbuild": "^0.20.2",
    "eslint": "^8.57.0",
    "rollup": "^4.14.0",
    "swc-loader": "^0.2.4",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0",
    "webpack": "^5.91.0"
  }
}
